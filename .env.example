# Database connection string
DATABASE_URL="file:./dev.db"

# Mật khẩu mặc định để đăng nhập
ACCESS_PASSWORD="SubLingoSecured2026"

# Session Secret (chuỗi ký mã cookie, bắt buộc đổi khi deploy)
SESSION_SECRET="your_long_random_session_secret_here"

# Tesseract path (để trống nếu cài global trong hệ thống PATH)
TESSERACT_PATH="C:\Program Files\Tesseract-OCR\tesseract.exe"

# Cấu hình Python AI Sidecar Service
PYTHON_AI_SERVICE_URL="http://localhost:8000"

# ==============================================
# Local AI Offline Configurations
# ==============================================
# Ollama Translation model (qwen2.5:1.5b-instruct, qwen2.5:3b-instruct, qwen2.5:7b-instruct-q4_K_M)
# 1.5b or 3b is highly recommended for weak CPUs / laptops without discrete GPU
OLLAMA_MODEL=qwen2.5:1.5b-instruct

# Whisper Speech-to-Text model size (tiny, base, small, medium, large-v3)
WHISPER_MODEL_SIZE=small

# VieNeu-TTS inference precision (int8, float32)
TTS_PRECISION=int8

# Max subtitle characters chunk size for translation split context
TRANSLATE_CHUNK_SIZE=8000

# ==============================================
# Gemini Online API Configurations (Optional)
# ==============================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL="gemini-2.0-flash"
GEMINI_MAX_RETRIES=4
GEMINI_RATE_LIMIT_RPM=10
GEMINI_RETRY_BASE_DELAY_MS=2000
